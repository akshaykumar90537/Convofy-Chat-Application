# Server Configuration
PORT=3000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/convofy
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/convofy?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/convofy

# JWT Secret Key for token signing & verification
JWT_SECRET=convofy-super-secret-key-change-this-in-production

